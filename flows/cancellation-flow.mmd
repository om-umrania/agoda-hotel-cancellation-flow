%% Text version of the logic and information flow. The authoritative, readable diagram is page 4 of the submission deck (flows/cancellation-flow.png).
%% Mermaid stacks swimlanes awkwardly, so treat this as a source outline.
flowchart LR
  subgraph T[Traveler]
    t1([Open My trips])
    t2[Tap Cancel booking]
    t3{Keep booking or Yes, cancel?}
  end
  subgraph A[Voya Android]
    a1[Show trip list]
    a2[Booking details with Cancel booking]
    a3[Loading: checking terms]
    a4[Review: refund, hotel, dates]
    a5[No quote shown: retry or support]
    a6[Confirmed, outcome unknown, or error]
    a7[Cancelled status, no Cancel button]
    a8[Contact support]
  end
  subgraph V[Voya backend]
    v1[Map Voya ID to Agoda bookingId]
    v2{Already cancelled?}
    v3{Self-service allowed?}
    v4[Request Cancel Preview]
    v5{Preview returned?}
    v6[Send Confirm with bookingId, reference, cancelReason, refundRate]
    v7[Recheck Booking Detail, update Voya record]
  end
  subgraph G[Agoda]
    g1[/Booking Detail: status, policy text, isFeeWaiverAllowed/]
    g2[/Cancel Preview: reference, paymentRate, refundRate, policy/]
    g3[/Cancel Confirm: HTTP 200 empty body, error, or no reply/]
  end
  t1 --> a1 --> v1 --> g1 --> v2
  v2 -- yes --> a7
  v2 -- no --> v3
  v3 -- no --> a8
  v3 -- yes --> a2 --> t2 --> a3 --> v4 --> g2 --> v5
  v5 -- error or timeout --> a5
  v5 -- yes --> a4 --> t3
  t3 -- keep: no Agoda call --> a2
  t3 -- yes, cancel --> v6 --> g3 --> v7 --> g1
  v7 --> a6
